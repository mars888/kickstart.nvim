-- https://github.com/ibhagwan/fzf-lua
-- Fuzzy find all the stuff.

return {
  'ibhagwan/fzf-lua',
  -- For icon support:
  dependencies = { 'nvim-tree/nvim-web-devicons' },
  opts = {},
  keys = function()
    local fzf = require 'fzf-lua'
    return {
      { '<leader>sG', fzf.global, desc = '[S]earch [G]lobal' },
      { '<leader>sh', fzf.help_tags, desc = '[S]earch [H]elp tags' },
      { '<leader>sk', fzf.keymaps, desc = '[S]earch [K]eymaps' },
      { '<leader>sf', fzf.files, desc = '[S]earch [F]iles' },
      { '<leader>s/', fzf.grep_curbuf, desc = '[S]earch current buffer' },
      { '<leader>sb', fzf.lines, desc = '[S]earch open [B]uffer lines' },
      { '<leader>sc', fzf.commands, desc = '[S]earch [C]ommands' },
      { '<leader>sw', fzf.grep_cword, desc = '[S]earch current [W]ord' },
      { '<leader>sg', fzf.live_grep_native, desc = '[S]earch by [G]rep' },
      { '<leader>sd', fzf.lsp_workspace_diagnostics, desc = '[S]earch [D]iagnostics' },
      { '<leader>st', fzf.tags, desc = '[S]earch buffer [T]ags' },
      { '<leader>swt', fzf.tags, desc = '[S]earch [W]orkspace [T]ags' },
      { '<leader>sr', fzf.resume, desc = '[S]earch [R]esume' },
      { '<leader>s.', fzf.oldfiles, desc = '[S]earch recent files ("." for repeat)' },
      { '<leader><leader>', fzf.buffers, desc = '[S]earch [B]uffers' },
    }
  end,
}
